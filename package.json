{
  "name": "murwaj-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "~19.3.0",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "format": "prettier --write src tests *.json *.md docs .github",
    "format:check": "prettier --check src tests *.json *.md docs .github",
    "lint": "expo lint"
  },
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "description": "Independent native customer app for the Murwaj Laravel API",
  "license": "MIT",
  "type": "module"
}
