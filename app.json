{
  "expo": {
    "name": "مروج | Murwaj",
    "slug": "murwaj-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "murwaj",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.murwaj.customer"
    },
    "android": {
